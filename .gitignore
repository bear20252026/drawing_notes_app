# Miscellaneous
*.class
*.log
*.pyc
__pycache__/
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing credentials and generated packages (never commit)
/android/key.properties
/android/*.jks
/android/*.keystore
/dist/

# 本地预编译工具二进制（CI 用 cargo 安装官方最新版，不提交二进制）
/tools/bin/

# 代码质量工具本地报告/缓存（CI 按需重新生成，不入库）
/.pyscn/
/.skylos/
/tools/uv.lock

# 工具本地状态/缓存（CI 重新生成，不入库）
/.desloppify/
/.hotspottriage/
/.repopilot/

# 本地 Windows UIA/截图测试脚手架（开发机专用，不入库）
/tools/capture_window.ps1
/tools/crop_image.ps1
/tools/dump_uia.ps1
/tools/install_test.ps1
/tools/ui_automate.ps1
