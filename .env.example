# 环境变量配置示例（安全加固 P0）
# 复制此文件为 .env 并填入实际值
# ⚠️ .env 文件已被 .gitignore 排除，不会提交到仓库

# ---- 加密服务 ----
# 加密盐值（生产环境必须使用随机值，至少 32 字符）
ENCRYPTION_SALT=your-encryption-salt-here

# ---- Nextcloud 同步 ----
# 服务器地址（如 https://cloud.example.com）
NEXTCLOUD_SERVER=
# 用户名
NEXTCLOUD_USERNAME=
# 应用密码（不是账户密码，在 Nextcloud 设置中生成）
NEXTCLOUD_PASSWORD=

# ---- 错误监控 ----
# Sentry DSN（可选，留空则禁用）
SENTRY_DSN=
